/* USER CODE BEGIN 4 */
void contadoroff(void){
	HAL_GPIO_WritePin(LED_AZUL_GPIO_Port, LED_AZUL_Pin,0);
	HAL_GPIO_WritePin(LED_ROJO_GPIO_Port, LED_ROJO_Pin,0);
	HAL_GPIO_WritePin(LED_AMARILLO_GPIO_Port, LED_AMARILLO_Pin,0);
	HAL_GPIO_WritePin(LED_VERDE_GPIO_Port, LED_VERDE_Pin,0);
}

void mostrarc(uint8_t contador){


	switch(contador){
	case 0:
		contadoroff();
		break;
	case 1:
		contadoroff();
		HAL_GPIO_WritePin(LED_AZUL_GPIO_Port, LED_AZUL_Pin,1);
		break;

	case 2:
		contadoroff();
		HAL_GPIO_WritePin(LED_VERDE_GPIO_Port, LED_VERDE_Pin,1);
		break;

	case 3:
		contadoroff();
		HAL_GPIO_WritePin(LED_AMARILLO_GPIO_Port, LED_AMARILLO_Pin,1);
		break;

	case 4:
		contadoroff();
		HAL_GPIO_WritePin(LED_ROJO_GPIO_Port, LED_ROJO_Pin,1);
		break;

	}

void contadord(void);{
	GPIO_PinState estadoB1;
	GPIO_PinState estadoB2;
	uint32_t tactual;

	tactual = HAL_GetTick();
	estadoB1 = HAL_GPIO_ReadPin(B1_GPIO_Port,B1_Pin);
	estadoB2 = HAL_GPIO_ReadPin(B2_GPIO_Port,B2_Pin);

	if ((estadoB1 == GPIO_PIN_0)&&(ultimoB1 == 1)&&((tactual - tB1)>= trebote)){
		contadord++;
		if(contadord > 4){
			contadord = 0;
		}

	tB1 = tactual;
	}
	if ((estadoB2 == GPIO_PIN_0)&&(ultimoB2 == 1)&&((tactual - tB2)>= trebote)){
		contadord--;
		if(contadord < 0){
			contadord = 4;
		}
	tB2 = tactual;
	}
	ultimoB1 = estadoB1;
	ultimoB2 = estadoB2;
}

void cambiomodo(void){
	GPIO_PinState estadoB3;
	uint32_t tactual;

	tactual = Hal_GetTick();
	estadoB3 = HAL_GPIO_ReadPin(B3_GPIO_Port,B3_Pin);

	if ((estadoB3 == GPIO_PIN_0)&&(ultimoB3 == 1)&&((tactual - tB1)>= trebote)){
		if(modo == 0){
			modo = 1;
		}

		else {
			modo = 0;
		}
	}

void rgboff(void){
    HAL_GPIO_WritePin(RGB_ROJO_GPIO_Port,RGB_ROJO_Pin,0);
    HAL_GPIO_WritePin(RGB_AZUL_GPIO_Port,RGB_AZUL_Pin,0);
    HAL_GPIO_WritePin(RGB_VERDE_GPIO_Port,RGB_VERDE_Pin,0);

}

void mostrarrgb(uint8_t contador){

	switch(contador){
	case 0:
		rgboff();
		break;

	case 1:
		rgboff();
		HAL_GPIO_WritePin(RGB_ROJO_GPIO_Port, RGB_ROJO_Pin,1);
		break;

	case 2:
		rgboff();
		HAL_GPIO_WritePin(RGB_ROJO_GPIO_Port, RGB_ROJO_Pin,1);
		HAL_GPIO_WritePin(RGB_AZUL_GPIO_Port, RGB_AZUL_Pin,1);
		break;

	case 3:
		rgboff();
		HAL_GPIO_WritePin(RGB_AZUL_GPIO_Port, RGB_AZUL_Pin,1);
		break;

	case 4:
		rgboff();
		HAL_GPIO_WritePin(RGB_VERDE_GPIO_Port, RGB_VERDE_Pin,1);
		HAL_GPIO_WritePin(RGB_AZUL_GPIO_Port, RGB_AZUL_Pin,1);
		break;

	case 5:
		rgboff();
		HAL_GPIO_WritePin(RGB_VERDE_GPIO_Port, RGB_VERDE_Pin,1);
		break;

	case 6:
		rgboff();
		HAL_GPIO_WritePin(RGB_ROJO_GPIO_Port, RGB_ROJO_Pin,1)
		HAL_GPIO_WritePin(RGB_VERDE_GPIO_Port, RGB_VERDE_Pin,1);
		break;

	}

void crgb(void){
	GPIO_PinState estadoB1;
	GPIO_PinState estadoB2;
	GPIO_PinState estadoB3;
	tactual = HAL-GetTick();

	estadoB1 = HAL_GPIO_ReadPin(B1_GPIO_Port,B1_Pin);
	estadoB2 = HAL_GPIO_ReadPin(B2_GPIO_Port,B2_Pin);

	if ((estadoB1 == GPIO_PIN_0)&&(ultimoB1 == 1)&&((tactual - tB1)>= trebote)){
		if (contargb < 6){
			contargb++;
		}
		tB1 = tactual;


	if ((estadoB2 == GPIO_PIN_0)&&(ultimoB2 == 1)&&((tactual - tB2)>= trebote)){
		if (contargb > 0){
			contargb--;
		}
		tB2 = tactual;
	}
	ultimoB1 = estadoB1;
	ultimoB2 = estadoB2;

}

